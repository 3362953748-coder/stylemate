# 云服务公开配置(可选)
# 不设置时使用 src/cloud.ts 中的默认值(指向公开的演示环境)。
# 部署自己的实例时,复制本文件为 .env 并填入对应值。

# 云服务数据面地址
VITE_CLOUD_ENDPOINT=https://stylemate-34839.app.workbuddy.host

# 应用标识密钥(前端可持有,服务端会校验 Origin)
VITE_CLOUD_PUBLISHABLE_KEY=wbpk_xxxxxxxxxxxx

# OAuth 中继地址(提供微信 / WorkBuddy 账号登录时必需)
VITE_CLOUD_OAUTH_RELAY=https://www.workbuddy.cn/v2/as/genie-baas/oauth

# 云服务资源 ID(可选)
VITE_CLOUD_RESOURCE_ID=wbcs_xxxxxxxxxxxx
